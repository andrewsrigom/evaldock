[
  {
    "name": "Record format · public-source v1",
    "config": {
      "kind": "json_schema",
      "metric_key": "schema_valid",
      "config": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "material",
            "weight_g",
            "country"
          ],
          "properties": {
            "material": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "weight_g": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      },
      "definition": {
        "threshold": 1,
        "aggregation": "mean",
        "direction": "higher",
        "required_inputs": [
          "actual"
        ]
      }
    }
  },
