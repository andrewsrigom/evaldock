    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.0",
    "tailwindcss": "^4.0.0",
